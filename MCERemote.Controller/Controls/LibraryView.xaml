<UserControl x:Class="MCERemote.Controller.Controls.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Controls="clr-namespace:MCERemote.Controller.Controls"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="700"
             Focusable="False">
    <Grid>
        <Controls:AlbumGridView x:Name="AlbumGrid" Visibility="Collapsed"
                                ItemInvoked="Content_ItemInvoked" ExitLeft="Content_ExitLeft" />

        <Controls:LibraryListView x:Name="EntryList" Visibility="Collapsed"
                                  ItemInvoked="Content_ItemInvoked" ExitLeft="Content_ExitLeft" />

        <TextBlock x:Name="EmptyStatus" Style="{StaticResource Page.Text.Secondary.Light}"
                   VerticalAlignment="Top" Visibility="Collapsed" />
    </Grid>
</UserControl>
