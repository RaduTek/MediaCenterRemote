<UserControl x:Class="MCERemote.Controller.Controls.AlbumGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="700"
             Focusable="False">

    <!-- Rows of tiles in a virtualized list; sized to a whole number of rows, see ListFitter -->
    <Border x:Name="GridArea" SizeChanged="GridArea_SizeChanged">
        <ListBox x:Name="Rows" VerticalAlignment="Top"
                 Style="{StaticResource Page.List}"
                 ItemContainerStyle="{StaticResource Library.Grid.Row}"
                 ItemTemplate="{StaticResource Library.Grid.RowTemplate}"
                 ScrollViewer.ScrollChanged="Rows_ScrollChanged"
                 GotFocus="Rows_GotFocus"
                 PreviewKeyDown="Rows_PreviewKeyDown" />
    </Border>
</UserControl>
