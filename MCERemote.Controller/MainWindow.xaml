<Window xmlns:Controls="clr-namespace:MCERemote.Controller.Controls"  xmlns:Layout="clr-namespace:MCERemote.Controller.Layout"  x:Class="MCERemote.Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCERemote.Controller"
        mc:Ignorable="d"
        Title="Media Remote Controller" 
        Height="600" Width="1024"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Foreground="White" 
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Cursor="None">
    <Grid>
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="/Resources/Background/Common.png" Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

        <Grid x:Name="ContentGrid">
            <Controls:ViewFrame x:Name="ViewFrame" 
                                HistoryChanged="ViewFrame_HistoryChanged" />

            <Layout:NowPlayingOverlay x:Name="NowPlayingOverlay" />

            <Layout:ControlBar x:Name="ControlBar" />
        </Grid>

        <Controls:DialogHost x:Name="DialogHost" 
                                Opened="DialogHost_Opened" 
                                Closed="DialogHost_Closed" />


        <Layout:TitleBar x:Name="TitleBar" 
                             CanGoToStart="False" 
                             CanGoBack="False"
                             TitleBarActionOccurred="TitleBar_TitleBarActionOccurred" />
    </Grid>
</Window>
