<UserControl x:Class="MCERemote.Controller.Layout.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCERemote.Controller.Layout"
             mc:Ignorable="d" 
             Height="69"
             d:DesignHeight="69" d:DesignWidth="1024"
             VerticalAlignment="Top"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary Source="../Resources/TitleBar/Styles.xaml"/>
    </UserControl.Resources>

    <Border>
        <Border.Background>
            <ImageBrush ImageSource="../Resources/TitleBar/Background.png"/>
        </Border.Background>

        <Grid Margin="0 0 0 18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource TitleBar.Button.Start}" Click="Button_Clicked" Tag="Start" />
            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource TitleBar.Button.Back}" Click="Button_Clicked" Tag="Back" Margin="0,4.5" />
            <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource TitleBar.Button.Settings}" Click="Button_Clicked" Tag="Settings" Margin="0,4.5" />

            <Button x:Name="MinimizeButton" Grid.Column="4" Style="{StaticResource TitleBar.Button.Minimize}" Click="Button_Clicked" Tag="Minimize" Margin="0,13,0,22" />
            <Button x:Name="CloseButton" Grid.Column="5" Style="{StaticResource TitleBar.Button.Close}" Click="Button_Clicked" Tag="Close" Margin="0,13,0,22" />
        </Grid>
    </Border>
</UserControl>
