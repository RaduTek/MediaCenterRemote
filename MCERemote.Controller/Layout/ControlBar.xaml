<UserControl x:Class="MCERemote.Controller.Layout.ControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCERemote.Controller.Layout"
             mc:Ignorable="d" 
             Height="70"
             Width="auto"
             HorizontalAlignment="Left"
             VerticalAlignment="Bottom" Loaded="UserControl_Loaded"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary Source="../Resources/ControlBar/Styles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="11" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <ImageBrush ImageSource="../Resources/ControlBar/Background.Fill.png" />
            </Border.Background>

            <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                
                <StackPanel Orientation="Horizontal" Width="138" Margin="5,0" Visibility="Collapsed">
                    <StackPanel.Background>
                        <ImageBrush ImageSource="../Resources/ControlBar/Group.2.Ch.png" />
                    </StackPanel.Background>
                    <Button x:Name="channelDown" Style="{StaticResource ControlBar.Button.Down}" 
                        Click="Button_Clicked" Tag="ChannelDown" Margin="3,0,0,0" />
                    <Button x:Name="channelUp" Style="{StaticResource ControlBar.Button.Up}" 
                        Click="Button_Clicked" Tag="ChannelUp" Margin="42,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Width="182" Margin="5,0">
                    <StackPanel.Background>
                        <ImageBrush ImageSource="../Resources/ControlBar/Group.3.png" />
                    </StackPanel.Background>
                    <CheckBox x:Name="playPause" Style="{StaticResource ControlBar.Button.PlayPause}" 
                          Click="Button_Clicked" Tag="PlayPause" Margin="4,0,0,0" />
                    <Button x:Name="stop" Style="{StaticResource ControlBar.Button.Stop}" 
                        Click="Button_Clicked" Tag="Stop" Margin="11,0,0,0" />
                    <CheckBox x:Name="record" Style="{StaticResource ControlBar.Button.Record}" 
                          Click="Button_Clicked" Tag="Record" Margin="13,0,0,0" />
                </StackPanel>
                

                <StackPanel Orientation="Horizontal" Width="108" Margin="5,0">
                    <StackPanel.Background>
                        <ImageBrush ImageSource="../Resources/ControlBar/Group.2.png" />
                    </StackPanel.Background>
                    <Button x:Name="previous" Style="{StaticResource ControlBar.Button.Previous}" 
                        Click="Button_Clicked" Tag="Previous" Margin="3,0,0,0" />
                    <Button x:Name="next" Style="{StaticResource ControlBar.Button.Next}"
                        Click="Button_Clicked" Tag="Next" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Width="51" Margin="5,0">
                    <StackPanel.Background>
                        <ImageBrush ImageSource="../Resources/ControlBar/Group.1.png" />
                    </StackPanel.Background>
                    <CheckBox x:Name="mute" Style="{StaticResource ControlBar.Button.Mute}" 
                              Click="Button_Clicked" Tag="ToggleMute" Margin="3" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Width="138" Margin="5,0">
                    <StackPanel.Background>
                        <ImageBrush ImageSource="../Resources/ControlBar/Group.2.Vol.png" />
                    </StackPanel.Background>
                    <Button x:Name="volumeDown" Style="{StaticResource ControlBar.Button.Down}" 
                        Click="Button_Clicked" Tag="VolumeDown" Margin="3,0,0,0" />
                    <Button x:Name="volumeUp" Style="{StaticResource ControlBar.Button.Up}" 
                        Click="Button_Clicked" Tag="VolumeUp" Margin="42,0,0,0" />
                </StackPanel>
                
            </StackPanel>
        </Border>

        <Image Grid.Column="1" Source="../Resources/ControlBar/Background.End.png" />
    </Grid>
</UserControl>
