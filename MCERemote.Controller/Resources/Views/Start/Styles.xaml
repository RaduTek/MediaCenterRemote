<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Controls="clr-namespace:MCERemote.Controller.Controls">

    <!--#region Tile List-->

    <Style x:Key="Start.Tiles.Scroller" TargetType="ScrollViewer">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="Start.Tiles" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--#endregion-->

    <!--#region Tile-->

    <Style x:Key="Start.Tile.Image" TargetType="Image">
        <Setter Property="Width" Value="220" />
        <Setter Property="Height" Value="220" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-32,-32,0" />
    </Style>

    <!-- Shows and fades out the pressed highlight layer named "highlight" -->
    <Storyboard x:Key="Start.Tile.Highlight.Show">
        <DoubleAnimation Storyboard.TargetName="highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
    </Storyboard>

    <Storyboard x:Key="Start.Tile.Highlight.Hide">
        <DoubleAnimation Storyboard.TargetName="highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
    </Storyboard>

    <Style x:Key="Start.Tile" TargetType="Controls:StartTile">
        <Style.Resources>
            <BitmapImage x:Key="Tile.Background.NoFocus" UriSource="Background.NoFocus.png" />
            <BitmapImage x:Key="Tile.Background.Focus" UriSource="Background.Focus.png" />
            <BitmapImage x:Key="Tile.Background.Highlight" UriSource="Background.Highlight.png" />
        </Style.Resources>

        <Setter Property="Width" Value="220" />
        <Setter Property="Height" Value="260" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Foreground" Value="#8FFF" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Controls:StartTile">
                    <Border x:Name="tileBorder">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource Tile.Background.NoFocus}"/>
                        </Border.Background>
                        <Grid>
                            <Border x:Name="highlight" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource Tile.Background.Highlight}"/>
                                </Border.Background>
                            </Border>
                            <Grid Margin="{TemplateBinding Padding}" ClipToBounds="True">
                                <Image x:Name="tileImage" Source="{TemplateBinding Image}" Style="{StaticResource Start.Tile.Image}" />
                                <ContentPresenter x:Name="tileText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="tileBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Tile.Background.Focus}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#EFFF" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Start.Tile.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Start.Tile.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="True" />
                                <Condition Property="Controls:ButtonHelper.IsEnterPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Start.Tile.Highlight.Show}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Start.Tile.Highlight.Hide}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->

</ResourceDictionary>
