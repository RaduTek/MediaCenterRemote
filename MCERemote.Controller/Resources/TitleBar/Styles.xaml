<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TitleBar.Button" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Blank.Disabled.2x.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Blank.Normal.2x.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Blank.Pressed.2x.png"/>
        </Style.Resources>

        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusManager.IsFocusScope" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource Button.Normal}"/>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Pressed}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Disabled}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="TitleBar.Button.Back" BasedOn="{StaticResource TitleBar.Button}" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Back.Disabled.2x.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Back.Normal.2x.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Back.Pressed.2x.png"/>
        </Style.Resources>
    </Style>

    <Style x:Key="TitleBar.Button.Blank" BasedOn="{StaticResource TitleBar.Button}" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Blank.Disabled.2x.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Blank.Normal.2x.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Blank.Pressed.2x.png"/>
        </Style.Resources>
    </Style>

    <Style x:Key="TitleBar.Button.Help" BasedOn="{StaticResource TitleBar.Button}" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Help.Disabled.2x.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Help.Normal.2x.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Help.Pressed.2x.png"/>
        </Style.Resources>
    </Style>

    <Style x:Key="TitleBar.Button.Settings" BasedOn="{StaticResource TitleBar.Button}" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Settings.Disabled.2x.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Settings.Normal.2x.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Settings.Pressed.2x.png"/>
        </Style.Resources>
    </Style>

    <Style x:Key="TitleBar.Button.Start" BasedOn="{StaticResource TitleBar.Button}" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Start.Disabled.2x.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Start.Normal.2x.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Start.Pressed.2x.png"/>
        </Style.Resources>

        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="47" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="TitleBar.Button.Minimize" BasedOn="{StaticResource TitleBar.Button}" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Minimize.Disabled.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Minimize.Normal.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Minimize.Pressed.png"/>
        </Style.Resources>

        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0 0 0 9" />
    </Style>

    <Style x:Key="TitleBar.Button.Close" BasedOn="{StaticResource TitleBar.Button}" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Disabled" UriSource="Buttons/Close.Disabled.png"/>
            <BitmapImage x:Key="Button.Normal" UriSource="Buttons/Close.Normal.png"/>
            <BitmapImage x:Key="Button.Pressed" UriSource="Buttons/Close.Pressed.png"/>
        </Style.Resources>

        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0 0 0 9" />
    </Style>

</ResourceDictionary>