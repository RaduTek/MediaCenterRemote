<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Text-->

    <Style x:Key="NowPlayingOverlay.Text" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="Margin" Value="0 0 12 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NowPlayingOverlay.Text.Line" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="NowPlayingOverlay.Text.Primary" TargetType="TextBlock" BasedOn="{StaticResource NowPlayingOverlay.Text.Line}">
        <Setter Property="Foreground" Value="#FFF" />
    </Style>

    <Style x:Key="NowPlayingOverlay.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource NowPlayingOverlay.Text.Line}">
        <Setter Property="Foreground" Value="#8FFF" />
    </Style>

    <!--#endregion-->

    <!--#region Cover-->

    <Style x:Key="NowPlayingOverlay.Cover" TargetType="Border">
        <Setter Property="Background" Value="Black" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000" Direction="320" ShadowDepth="6" BlurRadius="12" Opacity="0.5"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NowPlayingOverlay.Cover.Image" TargetType="Image">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Stretch" Value="UniformToFill" />
    </Style>

    <!--#endregion-->

</ResourceDictionary>
