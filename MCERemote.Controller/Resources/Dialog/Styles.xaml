<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Dialog.Host" TargetType="ContentControl">
        <Setter Property="Background" Value="#1000"/>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="0, 50, 0, 0" />
    </Style>

    <Style x:Key="Dialog.Body" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="Width" Value="350" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="#1FFF" CornerRadius="6" Padding="6">
                        <Border Padding="2" CornerRadius="3">
                            <Border.Background>
                                <ImageBrush ImageSource="Background.png" />
                            </Border.Background>
                            <StackPanel>
                                <ItemsPresenter />
                            </StackPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dialog.Text" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="8 4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Dialog.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#001030"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="8 4 8 0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Dialog.Buttons" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="2" Margin="2" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <StackPanel Margin="0 2 0 0">
                        <Image Source="Divider.png" Height="2" Stretch="Fill" />
                        <ItemsPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>