<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backdrops drawn behind a dialog, over the page. Set per dialog type, see DialogBase.BackdropKey -->
    <SolidColorBrush x:Key="Dialog.Backdrop" Color="#3000" />
    <SolidColorBrush x:Key="Dialog.Backdrop.Menu" Color="#3000" />

    <Style x:Key="Dialog.Host" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource Dialog.Backdrop}"/>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="0" />

        <!-- Draws the backdrop, which also catches clicks outside the dialog -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}">
                        <Grid Margin="0,50,0,0">
                            <ContentPresenter />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dialog.Body" TargetType="ItemsControl">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="Width" Value="350" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="#A0ADD1ED" CornerRadius="6" Padding="6">
                        <Border Padding="2" CornerRadius="3">
                            <Border.Background>
                                <ImageBrush ImageSource="Background.png" />
                            </Border.Background>
                            <StackPanel>
                                <ItemsPresenter />
                            </StackPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dialog.Text" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="8 4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Dialog.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#001030"/>
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="8 4 8 0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Header of a menu dialog, describing its subject -->
    <Style x:Key="Dialog.Menu.Header" TargetType="Border">
        <Setter Property="Padding" Value="0 2 0 6" />
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="Background.Header.png" Stretch="Fill" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dialog.Menu.Title" TargetType="TextBlock" BasedOn="{StaticResource Dialog.Title}">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Vertical list of options of a menu dialog, below a divider -->
    <Style x:Key="Dialog.Menu" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <StackPanel Margin="0 2 0 0">
                        <Image Source="Divider.png" Height="2" Stretch="Fill" />
                        <StackPanel Margin="2">
                            <ItemsPresenter />
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Dialog.Buttons" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="2" Margin="2" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <StackPanel Margin="0 2 0 0">
                        <Image Source="Divider.png" Height="2" Stretch="Fill" />
                        <ItemsPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>