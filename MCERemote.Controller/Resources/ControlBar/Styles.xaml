    <!--#region ControlBar Button PlayPause-->

    <Style x:Key="ControlBar.Button.PlayPause" TargetType="CheckBox">
        <Style.Resources>
            <BitmapImage x:Key="Button.Checked.Disabled" UriSource="Buttons/Pause.Disabled.png"/>
            <BitmapImage x:Key="Button.Checked.Normal" UriSource="Buttons/Pause.Normal.png"/>
            <BitmapImage x:Key="Button.Checked.Pressed" UriSource="Buttons/Pause.Pressed.png"/>

            <BitmapImage x:Key="Button.Unchecked.Disabled" UriSource="Buttons/Play.Disabled.png"/>
            <BitmapImage x:Key="Button.Unchecked.Normal" UriSource="Buttons/Play.Normal.png"/>
            <BitmapImage x:Key="Button.Unchecked.Pressed" UriSource="Buttons/Play.Pressed.png"/>
        </Style.Resources>

        <Setter Property="Width" Value="45" />
        <Setter Property="Height" Value="45" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusManager.IsFocusScope" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="border">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource Button.Unchecked.Normal}"/>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Checked.Normal}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Unchecked.Normal}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Checked.Pressed}"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Unchecked.Pressed}"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Checked.Disabled}"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Unchecked.Disabled}"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

