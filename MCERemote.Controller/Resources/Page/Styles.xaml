<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Page Text Styles-->

    <Style x:Key="Page.Text" TargetType="TextBlock">
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style x:Key="Page.Text.Primary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#FFF" />
    </Style>

    <Style x:Key="Page.Text.Primary.Light" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary}">
        <Setter Property="Foreground" Value="#8FFF" />
    </Style>

    <Style x:Key="Page.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="Page.Text.Secondary.Light" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary.Light}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="Page.Text.Tertiary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Page.Text.Tertiary.Light" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary.Light}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!--#endregion-->

    <!--#region Page Background-->

    <Style x:Key="Page.Background.Title" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="120" />
        <Setter Property="Foreground" Value="#2FFF" />
        <Setter Property="Margin" Value="-4 -45 0 0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="Page.Background.TrackIndex" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="225" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#2000" />
        <Setter Property="Margin" Value="0 0 0 30" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="Width" Value="250" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="Page.Background.TimeElapsed" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="90" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#1FFF" />
        <Setter Property="Margin" Value="0 0 0 -27" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="Width" Value="250" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!--#endregion-->

    <!--#region Page Layout-->

    <Style x:Key="Page.Layout.Primary" TargetType="ItemsControl">
        <Setter Property="FocusManager.IsFocusScope" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid FocusManager.IsFocusScope="False" KeyboardNavigation.IsTabStop="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="60" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="55" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.Layout.Title.Primary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="3" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>

    <Style x:Key="Page.Layout.Title.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="1" />
    </Style>

    <Style x:Key="Page.NowPlaying.TrackTotalTime" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0 0 50 15" />
    </Style>

    <!--#endregion-->

    <!--#region Page Controls-->

    <!--#region Buttons-->

    <Style x:Key="Page.Button" TargetType="Button">
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="12 5 12 7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="buttonBorder" Height="36">
                        <Border.Background>
                            <ImageBrush ImageSource="Button/Background.NoFocus.png"/>
                        </Border.Background>
                        <Border x:Name="buttonHighlight" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Disabled.png"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Focus.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>


                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonHighlight" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Focus.Highlight.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.Button.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="12 5 10 7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="buttonBorder" Height="36">
                        <Border.Background>
                            <ImageBrush ImageSource="Button/Background.NoFocus.png"/>
                        </Border.Background>
                        <Border x:Name="buttonHighlight" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" />
                                <Image x:Name="buttonSymbol" Grid.Column="1" Width="18"
                                       Visibility="Collapsed" Source="Button/Checkmark.Focus.png"  />
                            </Grid>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Disabled.png"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>
                        
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="buttonSymbol" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Focus.png"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Checkmark.Focus.png" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonHighlight" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Focus.Highlight.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.Button.Radio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="12 5 8 7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="buttonBorder" Height="36">
                        <Border.Background>
                            <ImageBrush ImageSource="Button/Background.NoFocus.png"/>
                        </Border.Background>
                        <Border x:Name="buttonHighlight" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" />
                                <Image x:Name="buttonSymbol" Grid.Column="1" Width="16"
                                       Source="Button/Radio.Outline.NoFocus.png"  />
                            </Grid>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Disabled.png"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Radio.Bullet.NoFocus.png" />
                        </Trigger>
                        
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Focus.png"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Radio.Outline.Focus.png" />
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonHighlight" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="Button/Background.Focus.Highlight.png"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Radio.Bullet.Focus.png" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->
    
    <!--#region Checkbox and Radio Button-->

    <Style x:Key="Page.Checkbox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="8 0 0 2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36">
                            <Image x:Name="checkSymbol" Source="CheckBox/Unchecked.NoFocus.png" />
                            <Image x:Name="checkHighlight" Source="CheckBox/Unchecked.Highlight.png" Visibility="Hidden" />
                        </Grid>
                        <Border Grid.Column="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Unchecked.Disabled.png" />
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Unchecked.Focus.png" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="checkHighlight" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Checked.NoFocus.png" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Checked.Disabled.png" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Checked.Focus.png" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkHighlight" Property="Source" Value="CheckBox/Checked.Highlight.png" />
                            <Setter TargetName="checkHighlight" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="8 0 0 2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36">
                            <Image x:Name="checkSymbol" Source="RadioButton/Unchecked.NoFocus.png" />
                            <Image x:Name="checkHighlight" Source="RadioButton/Unchecked.Highlight.png" Visibility="Hidden" />
                        </Grid>
                        <Border Grid.Column="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Unchecked.Disabled.png" />
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Unchecked.Focus.png" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="checkHighlight" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Checked.NoFocus.png" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Checked.Disabled.png" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Checked.Focus.png" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkHighlight" Property="Source" Value="RadioButton/Checked.Highlight.png" />
                            <Setter TargetName="checkHighlight" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--#endregion-->
    
    <!--#endregion-->

</ResourceDictionary>