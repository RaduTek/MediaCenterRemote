<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:MCERemote.Controller"
                    xmlns:Controls="clr-namespace:MCERemote.Controller.Controls">

    <!--#region Page Text Styles-->

    <Style x:Key="Page.Text" TargetType="TextBlock">
        <Setter Property="Margin" Value="1" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Page.Text.Primary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#FFF" />
    </Style>

    <Style x:Key="Page.Text.Primary.Light" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary}">
        <Setter Property="Foreground" Value="#8FFF" />
    </Style>

    <Style x:Key="Page.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary}">
        <Setter Property="FontSize" Value="23" />
    </Style>

    <Style x:Key="Page.Text.Secondary.Light" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary.Light}">
        <Setter Property="FontSize" Value="23" />
    </Style>

    <Style x:Key="Page.Text.Tertiary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="Page.Text.Tertiary.Light" TargetType="TextBlock" BasedOn="{StaticResource Page.Text.Primary.Light}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!--#endregion-->

    <!--#region Page Background-->

    <Style x:Key="Page.Background.Title" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="136" />
        <Setter Property="Foreground" Value="#2FFF" />
        <Setter Property="Margin" Value="-5 0 0 0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="Page.Background.TrackIndex" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="281" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#2000" />
        <Setter Property="Margin" Value="0 0 38 38" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="Page.Background.TimeElapsed" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="113" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#1FFF" />
        <Setter Property="Margin" Value="0 0 38 -34" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!--#endregion-->

    <!--#region Page Layout-->

    <Style x:Key="Page.Layout.Primary" TargetType="ItemsControl">
        <Setter Property="FocusManager.IsFocusScope" Value="False" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid FocusManager.IsFocusScope="False" KeyboardNavigation.IsTabStop="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="225" />
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="25" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="95" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="85" />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.Layout.Title.Primary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="3" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>

    <Style x:Key="Page.Layout.Title.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Page.Text}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="1" />
    </Style>

    <Style x:Key="Page.NowPlaying.TrackTotalTime" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0 0 63 19" />
    </Style>

    <!--#endregion-->

    <!--#region Page Controls-->

    <!--#region Press Highlight-->

    <!-- Shows and fades out the pressed highlight layer of a control template. The layer must be
         named "highlight" and start with Opacity 0. Use from trigger Enter/ExitActions. -->
    <Storyboard x:Key="Page.Highlight.Show">
        <DoubleAnimation Storyboard.TargetName="highlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
    </Storyboard>

    <Storyboard x:Key="Page.Highlight.Hide">
        <DoubleAnimation Storyboard.TargetName="highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4" />
    </Storyboard>

    <!--#endregion-->

    <!--#region Buttons-->

    <Style x:Key="Page.Button" TargetType="Button">
        <Style.Resources>
            <BitmapImage x:Key="Button.Background.NoFocus" UriSource="Button/Background.NoFocus.png" />
            <BitmapImage x:Key="Button.Background.Disabled" UriSource="Button/Background.Disabled.png" />
            <BitmapImage x:Key="Button.Background.Focus" UriSource="Button/Background.Focus.png" />
            <BitmapImage x:Key="Button.Background.Highlight" UriSource="Button/Background.Highlight.png" />
        </Style.Resources>
        
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="15 6 15 9" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="buttonBorder" Height="45">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource Button.Background.NoFocus}"/>
                        </Border.Background>
                        <Grid>
                            <Border x:Name="highlight" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Highlight}"/>
                                </Border.Background>
                            </Border>
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Disabled}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Focus}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="True" />
                                <Condition Property="Controls:ButtonHelper.IsEnterPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.Button.Wide" TargetType="Button" BasedOn="{StaticResource Page.Button}">
        <Style.Resources>
            <BitmapImage x:Key="Button.Background.Focus" UriSource="Button/Background.Wide.Focus.png" />
            <BitmapImage x:Key="Button.Background.Highlight" UriSource="Button/Background.Wide.Highlight.png" />
        </Style.Resources>
    </Style>

    <Style x:Key="Page.Button.CheckBox" TargetType="CheckBox">
        <Style.Resources>
            <BitmapImage x:Key="Button.Background.NoFocus" UriSource="Button/Background.NoFocus.png" />
            <BitmapImage x:Key="Button.Background.Disabled" UriSource="Button/Background.Disabled.png" />
            <BitmapImage x:Key="Button.Background.Focus" UriSource="Button/Background.Focus.png" />
            <BitmapImage x:Key="Button.Background.Highlight" UriSource="Button/Background.Highlight.png" />
        </Style.Resources>
        
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="15 6 13 9" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="buttonBorder" Height="45">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource Button.Background.NoFocus}"/>
                        </Border.Background>
                        <Grid>
                            <Border x:Name="highlight" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Highlight}"/>
                                </Border.Background>
                            </Border>
                            <Border Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" />
                                    <Image x:Name="buttonSymbol" Grid.Column="1" Width="23"
                                           Visibility="Collapsed" Source="Button/Checkmark.Focus.png"  />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Disabled}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>
                        
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="buttonSymbol" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Focus}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Checkmark.Focus.png" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.Button.Radio" TargetType="RadioButton">
        <Style.Resources>
            <BitmapImage x:Key="Button.Background.NoFocus" UriSource="Button/Background.NoFocus.png" />
            <BitmapImage x:Key="Button.Background.Disabled" UriSource="Button/Background.Disabled.png" />
            <BitmapImage x:Key="Button.Background.Focus" UriSource="Button/Background.Focus.png" />
            <BitmapImage x:Key="Button.Background.Highlight" UriSource="Button/Background.Highlight.png" />
        </Style.Resources>
        
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="15 6 10 9" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="buttonBorder" Height="45">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource Button.Background.NoFocus}"/>
                        </Border.Background>
                        <Grid>
                            <Border x:Name="highlight" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Highlight}"/>
                                </Border.Background>
                            </Border>
                            <Border Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" />
                                    <Image x:Name="buttonSymbol" Grid.Column="1" Width="20"
                                           Source="Button/Radio.Outline.NoFocus.png"  />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Disabled}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Radio.Bullet.NoFocus.png" />
                        </Trigger>
                        
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Focus}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Radio.Outline.Focus.png" />
                        </Trigger>
                        
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="buttonSymbol" Property="Source" Value="Button/Radio.Bullet.Focus.png" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->
    
    <!--#region Tile-->

    <Style x:Key="Page.Tile" TargetType="Controls:TileButton">
        <Style.Resources>
            <BitmapImage x:Key="Tile.Background.NoFocus" UriSource="Tile/Tile.NoFocus.png" />
            <BitmapImage x:Key="Tile.Background.Focus" UriSource="Tile/Tile.Focus.png" />
            <BitmapImage x:Key="Tile.Background.Highlight" UriSource="Tile/Tile.Highlight.png" />
        </Style.Resources>

        <Setter Property="Width" Value="155" />
        <!-- Kept tight so two rows of tiles with captions fit the page content area -->
        <Setter Property="Margin" Value="0 0 15 4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Foreground" Value="#AFFF" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Controls:TileButton">
                    <StackPanel>
                        <Grid Width="140" Height="140" HorizontalAlignment="Left">
                            <Border x:Name="tileBorder">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource Tile.Background.NoFocus}" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="highlight" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource Tile.Background.Highlight}" />
                                </Border.Background>
                            </Border>
                            <Image Source="{TemplateBinding Image}" Margin="{TemplateBinding Padding}" Stretch="UniformToFill" />
                        </Grid>

                        <!-- Caption sits below the tile background -->
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="2 0 2 0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#7FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="tileBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Tile.Background.Focus}" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FFF" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="True" />
                                <Condition Property="Controls:ButtonHelper.IsEnterPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->

    <!--#region Checkbox and Radio Button-->

    <Style x:Key="Page.Checkbox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="10 0 0 3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="45" Height="45">
                            <Image x:Name="checkSymbol" Source="CheckBox/Unchecked.NoFocus.png" />
                            <Image x:Name="highlight" Source="CheckBox/Unchecked.Highlight.png" Opacity="0" />
                        </Grid>
                        <Border Grid.Column="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Unchecked.Disabled.png" />
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Unchecked.Focus.png" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Checked.NoFocus.png" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Checked.Disabled.png" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="CheckBox/Checked.Focus.png" />
                        </MultiTrigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="highlight" Property="Source" Value="CheckBox/Checked.Highlight.png" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="10 0 0 3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="45" Height="45">
                            <Image x:Name="checkSymbol" Source="RadioButton/Unchecked.NoFocus.png" />
                            <Image x:Name="highlight" Source="RadioButton/Unchecked.Highlight.png" Opacity="0" />
                        </Grid>
                        <Border Grid.Column="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Unchecked.Disabled.png" />
                            <Setter Property="Foreground" Value="#8FFF" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Unchecked.Focus.png" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Checked.NoFocus.png" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Checked.Disabled.png" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkSymbol" Property="Source" Value="RadioButton/Checked.Focus.png" />
                        </MultiTrigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="highlight" Property="Source" Value="RadioButton/Checked.Highlight.png" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--#endregion-->
    
    <!--#region Text Input-->

    <Style x:Key="Page.TextInput" TargetType="TextBox">
        <Setter Property="Width" Value="225" />
        <Setter Property="Height" Value="45" />
        <Setter Property="Padding" Value="13 6 10 9" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="HorizontalAlignment" Value="Left" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Image x:Name="TextBoxBack" Source="TextBox/Background.NoFocus.png" Stretch="Fill" />
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="TextBoxBack" Property="Source" Value="TextBox/Background.Focus.png" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->

    <!--#region Scroll Bar-->

    <Style x:Key="Page.ScrollBar.Arrow" TargetType="RepeatButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Interval" Value="100" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="arrowBorder">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource ScrollBar.Arrow.Normal}" />
                        </Border.Background>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="arrowBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource ScrollBar.Arrow.Pressed}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.ScrollBar.Arrow.Up" TargetType="RepeatButton" BasedOn="{StaticResource Page.ScrollBar.Arrow}">
        <Style.Resources>
            <BitmapImage x:Key="ScrollBar.Arrow.Normal" UriSource="ScrollBar/Arrow.Up.png" />
            <BitmapImage x:Key="ScrollBar.Arrow.Pressed" UriSource="ScrollBar/Arrow.Up.Pressed.png" />
        </Style.Resources>
    </Style>

    <Style x:Key="Page.ScrollBar.Arrow.Down" TargetType="RepeatButton" BasedOn="{StaticResource Page.ScrollBar.Arrow}">
        <Style.Resources>
            <BitmapImage x:Key="ScrollBar.Arrow.Normal" UriSource="ScrollBar/Arrow.Down.png" />
            <BitmapImage x:Key="ScrollBar.Arrow.Pressed" UriSource="ScrollBar/Arrow.Down.Pressed.png" />
        </Style.Resources>
    </Style>

    <!-- Invisible page up / page down areas above and below the thumb -->
    <Style x:Key="Page.ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.ScrollBar.Thumb" TargetType="Thumb">
        <!--<Setter Property="MinHeight" Value="32" />-->
        <Setter Property="Background" Value="#6FFF" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="thumbBorder" Background="{TemplateBinding Background}" CornerRadius="4" />

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="thumbBorder" Property="Background" Value="#AFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="32" />
        <Setter Property="Background" Value="#2FFF" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Margin" Value="8 0 0 0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <RepeatButton Grid.Row="0" Style="{StaticResource Page.ScrollBar.Arrow.Up}" Command="ScrollBar.LineUpCommand" />

                        <Border Grid.Row="1" Background="{TemplateBinding Background}" CornerRadius="4" Margin="0,3" />

                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Margin="0,3">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Page.ScrollBar.Page}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Page.ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Page.ScrollBar.Page}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <RepeatButton Grid.Row="2" Style="{StaticResource Page.ScrollBar.Arrow.Down}" Command="ScrollBar.LineDownCommand" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Margin="{TemplateBinding Padding}" />

                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Style="{StaticResource Page.ScrollBar}"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->

    <!--#region List-->

    <Style x:Key="Page.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="ListScroller" Style="{StaticResource Page.ScrollViewer}"
                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Page.List.Item" TargetType="ListBoxItem">
        <Style.Resources>
            <BitmapImage x:Key="Button.Background.NoFocus" UriSource="Button/Background.Wide.NoFocus.png" />
            <BitmapImage x:Key="Button.Background.Focus" UriSource="Button/Background.Wide.Focus.png" />
            <BitmapImage x:Key="Button.Background.Highlight" UriSource="Button/Background.Wide.Highlight.png" />
        </Style.Resources>

        <Setter Property="Foreground" Value="#FFF" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="15 6 15 9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="itemBorder" Height="45">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource Button.Background.NoFocus}" />
                        </Border.Background>
                        <Grid>
                            <Border x:Name="highlight" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Highlight}" />
                                </Border.Background>
                            </Border>
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="itemBorder" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="{DynamicResource Button.Background.Focus}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="Controls:ButtonHelper.IsEnterPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Show}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Page.Highlight.Hide}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#endregion-->

    <!--#endregion-->

</ResourceDictionary>