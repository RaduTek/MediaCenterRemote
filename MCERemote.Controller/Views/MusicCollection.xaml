<Controls:PageView x:Class="MCERemote.Controller.Views.MusicCollection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:Controls="clr-namespace:MCERemote.Controller.Controls"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1024"
      Loaded="PageView_Loaded">

    <Grid>
        <TextBlock Text="music" Style="{StaticResource Page.Background.Title}" />

        <Controls:LayoutPrimary>
            <Controls:LayoutTitle x:Name="KindTitle" Text="ALBUM" Variant="Secondary" />
            <Controls:LayoutTitle x:Name="NameTitle" Text="Name" />
            
            <Grid Grid.Row="1" Grid.Column="3" Style="{StaticResource Library.Header}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Library.Header.Cover}">
                    <Image Source="/Resources/General/Audio.NoCover.png" Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock x:Name="InfoTitle" Style="{StaticResource Page.Text.Primary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,-3" />
                    <TextBlock x:Name="InfoArtist" Style="{StaticResource Page.Text.Secondary.Light}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,-3" />
                    <TextBlock x:Name="InfoSummary" Style="{StaticResource Page.Text.Tertiary.Light}" />
                </StackPanel>
            </Grid>

            <!-- Sidebar is empty for now, ready for options like Play or Add to Queue -->
            <StackPanel Grid.Row="3" Grid.Column="1" />

            <Grid Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Controls:LibraryView x:Name="LibraryContent" Grid.Row="1"
                                      ItemInvoked="Content_ItemInvoked"
                                      BusyChanged="Content_BusyChanged" />
            </Grid>
        </Controls:LayoutPrimary>
    </Grid>
</Controls:PageView>
