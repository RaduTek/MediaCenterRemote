<Page x:Class="MCERemote.Controller.Views.ConnectingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MCERemote.Controller.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Connecting"
      FontFamily="Tahoma"
      FontSize="18"
      Loaded="Page_Loaded">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="statusLabel" Margin="0 6" Foreground="White" Content="Please wait..."/>
            <Button x:Name="cancelButton" Padding="8 4" HorizontalAlignment="Center" 
                    Content="Cancel" Click="cancelButton_Click" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
