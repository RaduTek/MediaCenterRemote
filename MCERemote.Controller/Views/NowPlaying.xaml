<Controls:PageView xmlns:Controls="clr-namespace:MCERemote.Controller.Controls"  x:Class="MCERemote.Controller.Views.NowPlaying"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1024"
      Title="Now Playing"
      ShowNowPlayingOverlay="False"
      Loaded="PageView_Loaded"
      Unloaded="PageView_Unloaded">
    <Controls:PageView.Resources>
        <DataTemplate x:Key="QueueItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path x:Name="CurrentMarker" Grid.Column="0" Data="M 0 0 L 10 6 L 0 12 Z" Fill="#FFF"
                      VerticalAlignment="Center" Margin="0 2 10 0" Visibility="Collapsed" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LoadingText" Grid.Column="1" Text="Loading..." Foreground="#8FFF" Visibility="Collapsed" />
                <TextBlock x:Name="ArtistText" Grid.Column="2" Text="{Binding Artist}" Foreground="#8FFF" MaxWidth="200"
                           TextTrimming="CharacterEllipsis" Margin="15 0 0 0" />
                <TextBlock x:Name="DurationText" Grid.Column="3" Text="{Binding DurationText}" Foreground="#8FFF" Margin="15 0 0 0" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="CurrentMarker" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <!-- Never loaded yet; outdated items keep showing their old details until reloaded -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLoaded}" Value="False" />
                        <Condition Binding="{Binding Title}" Value="" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LoadingText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ArtistText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DurationText" Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Controls:PageView.Resources>

    <Grid>
        <TextBlock x:Name="BackgroundTitle" Text="music" Style="{StaticResource Page.Background.Title}" />
        <TextBlock x:Name="TrackIndex" Text="01" Style="{StaticResource Page.Background.TrackIndex}" Visibility="Hidden" />
        <TextBlock x:Name="TimeElapsed" Text="00:00" Style="{StaticResource Page.Background.TimeElapsed}"  />
        <StackPanel Style="{StaticResource Page.NowPlaying.TrackTotalTime}">
            <TextBlock x:Name="TrackTimeText" Style="{StaticResource Page.Text.Tertiary.Light}" Margin="6 0" Text="TRACK TIME" />
            <TextBlock x:Name="TimeTotal" Style="{StaticResource Page.Text.Tertiary}" Margin="6 0" Text="00:00" />
        </StackPanel>


        <Controls:LayoutPrimary x:Name="CommonView">
            <StackPanel Grid.Row="3" Grid.Column="1" PreviewKeyDown="SideButtons_PreviewKeyDown">
                <Controls:ButtonRadio x:Name="ViewCoverButton" IsChecked="True" Click="ViewCoverButton_Click">View Cover</Controls:ButtonRadio>
                <Controls:ButtonRadio x:Name="ViewQueueButton" Click="ViewQueueButton_Click">View Queue</Controls:ButtonRadio>
                <Controls:ButtonCheck x:Name="ShuffleButton" Click="ShuffleButton_Click">Shuffle</Controls:ButtonCheck>
                <Controls:ButtonCheck x:Name="RepeatButton" Click="RepeatButton_Click">Repeat</Controls:ButtonCheck>
                <Controls:Button x:Name="VisualizeButton" IsEnabled="False" Click="VisualizeButton_Click">Visualize</Controls:Button>
                <Controls:Button x:Name="EditQueueButton" IsEnabled="False" Click="EditQueueButton_Click">Edit Queue</Controls:Button>
            </StackPanel>
        </Controls:LayoutPrimary>

        <Controls:LayoutPrimary x:Name="CoverView" Margin="50 0 0 0">
            <Controls:LayoutTitle x:Name="NowPlayingTitle" Text="NOW PLAYING" Variant="Secondary" />
            <Controls:LayoutTitle x:Name="AlbumAndArtist" Text="ALBUM TITLE: Album Artist" />

            <StackPanel x:Name="CoverPanel" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2">
                <Border Background="Black"  HorizontalAlignment="Left" Margin="0 0 9 9">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" Direction="320" ShadowDepth="15" BlurRadius="25" Opacity="0.5"/>
                    </Border.Effect>
                    <Image x:Name="AlbumArt" Width="250" Height="250" Source="/Resources/General/Audio.NoCover.png" />
                </Border>

                <TextBlock x:Name="TrackTitle" Style="{StaticResource Page.Text.Primary}" Text="Track Title" />
                <TextBlock x:Name="Year" Style="{StaticResource Page.Text.Primary}" Text="Year" />
            </StackPanel>
        </Controls:LayoutPrimary>

        <Controls:LayoutPrimary x:Name="QueueView">
            <Controls:LayoutTitle x:Name="QueueTitle" Text="QUEUE" Variant="Secondary" />
            
            <!-- The list is sized to a whole number of items within this area, see UpdateQueueListHeight -->
            <Border x:Name="QueueArea" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Margin="0 0 0 10"
                    SizeChanged="QueueArea_SizeChanged">
                <ListBox x:Name="QueueList" VerticalAlignment="Top"
                         Style="{StaticResource Page.List}"
                         ItemContainerStyle="{StaticResource Page.List.Item}"
                         ItemTemplate="{StaticResource QueueItemTemplate}"
                         ScrollViewer.ScrollChanged="QueueList_ScrollChanged"
                         GotFocus="QueueList_GotFocus"
                         PreviewKeyDown="QueueList_PreviewKeyDown"
                         PreviewKeyUp="QueueList_PreviewKeyUp"
                         PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="QueueList_PreviewMouseLeftButtonUp"
                         MouseLeave="QueueList_MouseLeave" />
            </Border>

            <TextBlock x:Name="QueueStatus" Grid.Row="3" Grid.Column="3"
                       Style="{StaticResource Page.Text.Secondary.Light}"
                       VerticalAlignment="Top" Visibility="Collapsed" />
        </Controls:LayoutPrimary>
    </Grid>
</Controls:PageView>
