<local:PageView x:Class="MCERemote.Controller.Views.NowPlaying"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MCERemote.Controller.Views"
      mc:Ignorable="d" 
      d:DesignHeight="448" d:DesignWidth="800"
      Title="Now Playing" Loaded="PageView_Loaded">
    <Page.Resources>
    </Page.Resources>

    <Grid>
        <TextBlock x:Name="nowPlayingText" Text="music" Style="{StaticResource Page.Background.Title}" />

        <TextBlock x:Name="trackIndex" Text="11" Style="{StaticResource Page.Background.TrackIndex}" />

        <TextBlock x:Name="timeElapsed" Text="00:00" Style="{StaticResource Page.Background.TimeElapsed}"  />

        <StackPanel Style="{StaticResource Page.NowPlaying.TrackTotalTime}">
            <TextBlock x:Name="trackTimeText" Style="{StaticResource Page.Text.Tertiary.Light}" Margin="5 0" Text="TRACK TIME" />
            <TextBlock x:Name="timeTotal" Style="{StaticResource Page.Text.Tertiary}" Margin="5 0" Text="01:23" />
        </StackPanel>


        <ItemsControl Style="{StaticResource Page.Layout.Primary}" Margin="50 0 0 0">
            <TextBlock x:Name="artist" Style="{StaticResource Page.Layout.Title.Secondary}" Text="NOW PLAYING" />
            
            <TextBlock x:Name="albumArtist" Style="{StaticResource Page.Layout.Title.Primary}" Text="ALBUM TITLE: Album Artist" />

            <StackPanel Grid.Row="3" Grid.Column="1">
                <RadioButton Style="{StaticResource Page.Button.Radio}">View Cover</RadioButton>
                <RadioButton Style="{StaticResource Page.Button.Radio}">View Queue</RadioButton>
                <CheckBox Style="{StaticResource Page.Button.CheckBox}">Shuffle</CheckBox>
                <CheckBox Style="{StaticResource Page.Button.CheckBox}">Repeat</CheckBox>
                <Button Style="{StaticResource Page.Button}">Visualize</Button>
                <Button Style="{StaticResource Page.Button}">Edit Queue</Button>
            </StackPanel>
            
            <StackPanel Grid.Row="3" Grid.Column="3">
                <Border Background="Black"  HorizontalAlignment="Left" Margin="0 0 7 7">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" Direction="320" ShadowDepth="12" BlurRadius="20" Opacity="0.5"/>
                    </Border.Effect>
                    <Image x:Name="albumArt" Width="200" Height="200" />
                </Border>

                <TextBlock x:Name="trackTitle" Style="{StaticResource Page.Text.Primary}" Text="Track Title" />
                <TextBlock x:Name="year" Style="{StaticResource Page.Text.Primary}" Text="Year" />
            </StackPanel>
        </ItemsControl>
    </Grid>
</local:PageView>
