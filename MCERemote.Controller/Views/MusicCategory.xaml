<Controls:PageView x:Class="MCERemote.Controller.Views.MusicCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:Controls="clr-namespace:MCERemote.Controller.Controls"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1024"
      Loaded="PageView_Loaded">

    <Grid>
        <TextBlock Text="music" Style="{StaticResource Page.Background.Title}" />

        <Controls:LayoutPrimary>
            <Controls:LayoutTitle x:Name="KindTitle" Text="ARTIST" Variant="Secondary" />
            <Controls:LayoutTitle x:Name="NameTitle" Text="Name" />

            <StackPanel Grid.Row="3" Grid.Column="1" PreviewKeyDown="Sidebar_PreviewKeyDown">
                <Controls:ButtonRadio x:Name="AlbumsButton" IsChecked="True" Click="AlbumsButton_Click">View Albums</Controls:ButtonRadio>
                <Controls:ButtonRadio x:Name="SongsButton" Click="SongsButton_Click">View Songs</Controls:ButtonRadio>
            </StackPanel>

            <Controls:LibraryView x:Name="LibraryContent" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Margin="0 0 0 10"
                                  ItemInvoked="Content_ItemInvoked"
                                  ExitLeft="Content_ExitLeft"
                                  BusyChanged="Content_BusyChanged"
                                  GotFocus="Content_GotFocus" />
        </Controls:LayoutPrimary>
    </Grid>
</Controls:PageView>
