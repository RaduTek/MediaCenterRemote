<Controls:PageView x:Class="MCERemote.Controller.Views.Start"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:Controls="clr-namespace:MCERemote.Controller.Controls"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1024"
      Title="Start" Loaded="PageView_Loaded" IsEnabledChanged="PageView_IsEnabledChanged">
    <Controls:PageView.Resources>
        <ResourceDictionary Source="../Resources/Views/Start/Styles.xaml"/>
    </Controls:PageView.Resources>

    <Grid>
        <TextBlock Text="start" Style="{StaticResource Page.Background.Title}" />

        <Image Source="/MCERemote.Controller;component/Resources/Views/Start/Start.Logo.png" 
               Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,30,0"
               Opacity="0.9" Width="177" Height="34" />
        
        <ScrollViewer x:Name="TilesScroller" Style="{StaticResource Start.Tiles.Scroller}">
            <StackPanel x:Name="Tiles" Style="{StaticResource Start.Tiles}"
                        PreviewKeyDown="Tiles_PreviewKeyDown"
                        GotFocus="Tiles_GotFocus">
                <Controls:StartTile Tag="NowPlaying" Click="Tile_Click" Image="/MCERemote.Controller;component/Resources/Views/Start/Start.DVD.png">now playing</Controls:StartTile>
                <Controls:StartTile Tag="Music" Click="Tile_Click" Image="/MCERemote.Controller;component/Resources/Views/Start/Start.Music.png">music</Controls:StartTile>
                <Controls:StartTile Tag="Pictures" Click="Tile_Click" Image="/MCERemote.Controller;component/Resources/Views/Start/Start.Photos.png">pictures</Controls:StartTile>
                <Controls:StartTile Tag="Videos" Click="Tile_Click" Image="/MCERemote.Controller;component/Resources/Views/Start/Start.Video.png">videos</Controls:StartTile>
                <Controls:StartTile Tag="Extras" Click="Tile_Click" Image="/MCERemote.Controller;component/Resources/Views/Start/Start.Extras.png">extras</Controls:StartTile>
                <Controls:StartTile Tag="Extras" Click="Tile_Click" Image="/MCERemote.Controller;component/Resources/Views/Start/Start.Remote.png">remote</Controls:StartTile>
                <Controls:StartTile Tag="Settings" Click="Tile_Click" Image="/MCERemote.Controller;component/Resources/Views/Start/Start.Settings.png">settings</Controls:StartTile>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Controls:PageView>
